{
  "run_name": "A1_dino_ssl_mobilenetv2",
  "_note": "DINO SSL stage only. Keys inside the sections use the original main_dino.py argument names where one exists; all sections are merged into one flat settings object. Origin of every value: README.md, section 'SSL recipe'.",

  "setup": {
    "seed": 0,
    "init": "imagenet",
    "ssl_csv": "ssl_training_data.csv",
    "cache_pixels": true,
    "num_workers": 2,
    "device": "cuda",
    "log_every_steps": 100
  },

  "views": {
    "global_crop_size": 224,
    "global_crops_scale": [0.4, 1.0],
    "local_crops_number": 8,
    "local_crop_size": 96,
    "local_crops_scale": [0.15, 0.4],
    "hflip_p": 0.5,
    "color_jitter_p": 0.8,
    "brightness": 0.4,
    "contrast": 0.4,
    "blur_p": [1.0, 0.1, 0.5],
    "solarization_p": 0.0,
    "normalize_mean": [0.485, 0.456, 0.406],
    "normalize_std": [0.229, 0.224, 0.225]
  },

  "dino": {
    "out_dim": 4096,
    "use_bn_in_head": false,
    "norm_last_layer": true,
    "momentum_teacher": 0.9995,
    "warmup_teacher_temp": 0.04,
    "teacher_temp": 0.04,
    "warmup_teacher_temp_epochs": 0,
    "student_temp": 0.1,
    "center_momentum": 0.9
  },

  "optim": {
    "optimizer": "adamw",
    "lr": 0.0005,
    "_lr_note": "reference rate for a batch of 256; the rate actually used is lr * batch_size_per_gpu / 256 (linear scaling rule, as in main_dino.py). It is printed and saved as effective_peak_lr.",
    "min_lr": 1e-06,
    "warmup_epochs": 10,
    "weight_decay": 0.04,
    "weight_decay_end": 0.04,
    "clip_grad": 3.0,
    "batch_size_per_gpu": 64,
    "epochs": 100,
    "freeze_last_layer": 1,
    "use_fp16": true
  }
}
