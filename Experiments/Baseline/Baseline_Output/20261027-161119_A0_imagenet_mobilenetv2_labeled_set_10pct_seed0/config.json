{
  "run_name": "A0_imagenet_mobilenetv2_labeled_set_10pct",
  "init": {
    "type": "imagenet",
    "backbone_checkpoint": null
  },
  "data": {
    "train_csv": "labeled_set_10pct.csv",
    "val_csv": "validation.csv",
    "input_size": 224,
    "normalize_mean": [
      0.485,
      0.456,
      0.406
    ],
    "normalize_std": [
      0.229,
      0.224,
      0.225
    ],
    "augment_hflip_p": 0.5,
    "augment_translate_pad": 8,
    "cache_in_memory": true,
    "num_workers": 0
  },
  "train": {
    "seed": 0,
    "epochs": 30,
    "batch_size": 64,
    "optimizer": "adamw",
    "lr": 0.0005,
    "weight_decay": 0.01,
    "scheduler": "cosine",
    "device": "cuda",
    "log_every_batches": 25,
    "_device_note": "GPU (RTX 4070 SUPER) for now. For the CPU timing runs later, set device to \"cpu\" (or run train.py --device cpu); \"auto\" picks the GPU when available. The device used is recorded in run_info.json."
  },
  "smoke": false
}