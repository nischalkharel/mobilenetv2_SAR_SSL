# Claude Code context and handoff log (local only)
CLAUDE.md
claude_log.md

# Python environment and caches
.venv/
__pycache__/
*.pyc

# Decoded SSL pixels (about 1.1 GB each, rebuilt automatically when missing)
Experiments/mobileNetv2_DINO/outputs/cache/
Experiments/mobileNetv2_LeJEPA/outputs/cache/

# Smoke-test runs (pipeline checks, not results)
Experiments/*/outputs/smoke/

# Weights and checkpoints (large; move with scp when needed). The ImageNet start file is copied
# separately on each machine and identified by its SHA-256 in every run record.
*.pth
*.pt
*.npy
*.tmp

# Copies of the 10 MB SSL image list inside each SSL run folder (its SHA-256 is in manifests.json)
Experiments/*/outputs/ssl/*/manifests/ssl_training_data.csv
