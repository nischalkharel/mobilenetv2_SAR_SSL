{
  "run_name": "viewscale_e64_ssl_mobilenetv2",
  "method": "viewscale",
  "common": {
    "epochs": 100,
    "batch_size": 64,
    "seed_rule": "split - 1",
    "num_workers": 8,
    "export_rule": "final epoch, no selection",
    "seed": 2
  },
  "views": {
    "resize_rule": "detector_512",
    "global_size": 224,
    "local_size": 96,
    "zoom_range": [
      0.75,
      1.33
    ],
    "hflip_p": 0.5,
    "brightness": 0.4,
    "contrast": 0.4,
    "color_jitter_p": 0.8,
    "blur_sigma": [
      0.1,
      2.0
    ],
    "solarization_p": 0.0
  },
  "object_views": {
    "objects_per_image": 3,
    "obj_global_size": 96,
    "obj_local_size": 64,
    "obj_local_number": 4,
    "obj_global_zoom": [
      1.4,
      2.2
    ],
    "obj_local_zoom": [
      0.5,
      1.0
    ],
    "min_object_px": 12,
    "max_magnification": 2.0,
    "region_source": "fixed",
    "region_sampling": "sqrt_area",
    "obj_blur_p": [
      1.0,
      0.1,
      0.5
    ],
    "_note": "fixed_extent_px is the window extent e; object-global windows = e x obj_global_zoom (floor obj_global_size / max_magnification), object-local = e x obj_local_zoom",
    "fixed_extent_px": 64
  },
  "dino": {
    "out_dim": 4096,
    "use_bn_in_head": false,
    "norm_last_layer": true,
    "momentum_teacher": 0.9995,
    "warmup_teacher_temp": 0.04,
    "teacher_temp": 0.04,
    "warmup_teacher_temp_epochs": 0,
    "student_temp": 0.1,
    "center_momentum": 0.9
  },
  "optim": {
    "optimizer": "adamw",
    "lr": 0.0005,
    "min_lr": 1e-06,
    "warmup_epochs": 10,
    "weight_decay": 0.04,
    "weight_decay_end": 0.04,
    "clip_grad": 3.0,
    "freeze_last_layer": 1,
    "use_fp16": true
  },
  "smoke": false
}