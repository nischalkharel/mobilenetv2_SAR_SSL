{
  "run_name": "lejepa_ssl_mobilenetv2",
  "method": "lejepa",
  "common": {
    "epochs": 100,
    "batch_size": 64,
    "seed_rule": "split - 1",
    "num_workers": 8,
    "export_rule": "final epoch, no selection",
    "seed": 0
  },
  "views": {
    "resize_rule": "detector_512",
    "global_size": 224,
    "local_size": 96,
    "zoom_range": [
      0.75,
      1.33
    ],
    "hflip_p": 0.5,
    "brightness": 0.4,
    "contrast": 0.4,
    "color_jitter_p": 0.8,
    "blur_sigma": [
      0.1,
      2.0
    ],
    "solarization_p": 0.0
  },
  "lejepa_views": {
    "n_global_views": 8,
    "_views_note": "all views are global at the shared global_size (224): paper Section 5.1, for non-ViT backbones set global_views = all_views; no local views",
    "blur_p": 0.5
  },
  "lejepa": {
    "proj_hidden_dim": 2048,
    "proj_dim": 512,
    "lamb": 0.05,
    "num_slices": 1024,
    "t_max": 3.0,
    "n_points": 17
  },
  "optim": {
    "optimizer": "adamw",
    "lr": 0.0005,
    "_lr_note": "absolute value from the authors' README (5e-4); NOT scaled with the batch size, unlike DINO",
    "weight_decay": 0.0005,
    "warmup_epochs": 1,
    "warmup_start_factor": 0.01,
    "final_lr_ratio": 0.001,
    "precision": "bf16"
  },
  "smoke": false
}